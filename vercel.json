{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "buildCommand": "python manage.py collectstatic --noinput --clear",
  "routes": [
    {
      "src": "/static/(.*)",
      "dest": "/otp_login/static/$1"
    },
    {
      "src": "/(.*)",
      "dest": "api/index.py"
    }
  ]
}
