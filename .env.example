# Django/Vercel
DJANGO_DEBUG=false
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql://user:password@host/database?sslmode=require
DJANGO_ALLOWED_HOSTS=.vercel.app,your-domain.com
DJANGO_CSRF_TRUSTED_ORIGINS=https://*.vercel.app,https://your-domain.com
DJANGO_CORS_ALLOWED_ORIGINS=https://your-domain.com

# Gemini OCR
GOOGLE_API_KEY=replace-with-your-google-gemini-api-key
GOOGLE_OCR_MODELS=gemini-3.7-flash
ENABLE_GEMINI_SUMMARY=true

# Optional email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true

# Optional DigiLocker
ENABLE_MOCK_DIGILOCKER=false
DIGILOCKER_CLIENT_ID=
DIGILOCKER_CLIENT_SECRET=
DIGILOCKER_REDIRECT_URI=https://your-domain.com/auth/api/digilocker/callback/
